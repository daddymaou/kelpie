{
	"name": "@kelpie/site",
	"version": "0.1.0",
	"license": "Apache-2.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && pagefind --site .svelte-kit/output/prerendered --output-subdir pagefind",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "vite dev",
		"preview": "vite preview",
		"test": "vitest run",
		"typecheck": "svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.1.1",
		"@fontsource-variable/geist-mono": "^5.1.1",
		"@fontsource/instrument-serif": "^5.1.1",
		"@kelpie/core": "workspace:*",
		"@kelpie/protocol": "workspace:*",
		"@kelpie/sim": "workspace:*",
		"mdsvex": "^0.12.3",
		"rehype-pretty-code": "^0.14.1",
		"shiki": "^1.26.1",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/kit": "^2.15.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"pagefind": "^1.3.0",
		"svelte": "^5.16.0",
		"svelte-check": "^4.1.2",
		"vite": "^6.0.7"
	}
}
