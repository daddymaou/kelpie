# ---------------------------------------------------------------------------
# Public site URL.
#
# Used for: canonical <link> tags, Open Graph / Twitter URLs, sitemap.xml,
# robots.txt, and the WebSite JSON-LD @id. Set this to your real origin before
# building for production — everything here is prerendered at build time, so
# the value is baked into the static HTML and will not change at runtime.
#
# If unset, the fallback in src/lib/site.ts (https://kelpie.dev) is used.
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=https://kelpie.dev