{
	"name": "kelpie-site",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@9.15.4",
	"engines": {
		"node": ">=20.11"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm run search:index",
		"preview": "vite preview",
		"search:index": "pagefind --site build",
		"search:serve": "pagefind --site build --serve",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && pnpm run check",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^4.0.0",
		"@sveltejs/enhanced-img": "0.6.0",
		"@sveltejs/kit": "^2.15.2",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/node": "^22.10.6",
		"mdsvex": "^0.12.3",
		"pagefind": "^1.3.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"shiki": "^1.26.1",
		"sharp": "^0.33.5",
		"svelte": "^5.16.0",
		"svelte-check": "^4.1.2",
		"typescript": "^5.7.3",
		"vite": "^6.0.7"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.1.1",
		"@fontsource-variable/geist-mono": "^5.1.1",
		"@fontsource/instrument-serif": "^5.1.1",
		"rehype-pretty-code": "^0.14.1",
		"zod": "^3.24.1"
	}
}